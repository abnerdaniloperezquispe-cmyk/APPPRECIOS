        <td>${escapeHtml(p.nombre)}</td>
        <td>${escapeHtml(p.marca || '-')}</td>
        <td>${p.categoria ? `<span class="badge badge-muted">${escapeHtml(p.categoria)}</span>` : '-'}</td>
        <td>${fmtMoney(p.precioCompra)}</td>
        <td>${fmtMoney(p.precioMarca)}</td>
